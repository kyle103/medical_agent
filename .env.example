# 文档版本：V1.0
# 生效日期：{{文档生成日期}}  # 待用户手动填充

# ========== 1) LLM 模型配置 ==========
LLM_API_BASE={{LLM_API地址}}  # 待用户手动填充
LLM_API_KEY={{LLM_API密钥}}  # 待用户手动填充
LLM_MODEL_NAME={{LLM模型名称}}  # 待用户手动填充
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
# 结构化输出档位：auto / json_schema / json_object
# auto = 运行时探测模型是否真的下发 schema，并在启动日志打印实际生效档位
# 背景：response_format 的支持度「逐模型快照不同」，不是提供方统一属性。
#   实测（dashscope compatible-mode，2026-09-12）：
#     支持 json_schema : deepseek-v4-flash / deepseek-v4-pro / deepseek-v3.2 /
#                        qwen3.8-flash / qwen3.8-max / qwen3.7-flash / qwen-flash
#     静默不生效       : deepseek-v4-flash-0731（带日期快照） / qwen3.6-flash
#   "静默不生效"指接口不报错、JSON 也合法，但字段名/枚举/类型都不受 schema 约束。
#   验证脚本：scripts/probe_model_matrix.py <模型名>  /  scripts/probe_schema_strictness.py
STRUCTURED_OUTPUT_MODE=auto

# ---- 视觉 LLM（化验单图像识别专用；留空 = 关闭图片识别）----
# 必须与 LLM_MODEL_NAME **分开配**：文本主模型没有视觉能力，"跟随主流程"只能等价于
# 把已验证的文本主链路换成 VL 模型，收益为零、风险很大。
#   实测（dashscope compatible-mode，2026-09-13）视觉模型候选：
#     qwen3-vl-flash / qwen3-vl-plus / qwen-vl-max / qwen-vl-ocr …
#   选型实验：多模态化验单识别-选型实验与集成方案.md
#   ⚠️ 一律用**去日期后缀**的名字：带日期快照的兼容层可能丢 response_format，
#      导致 json_schema 静默失效（文本侧已踩过 deepseek-v4-flash-0731）。
#   验证脚本：scripts/probe_lab_vision_params.py（档位 + 思考开关是否被接受）
LLM_VISION_MODEL_NAME=
LLM_VISION_TIMEOUT_S=60
LLM_VISION_MAX_TOKENS=2048
# 是否下发 extra_body.enable_thinking=False。默认 0（不下发）——该参数是提供方耦合点，
# 未被探针确认可用前不进默认路径。换模型/换提供方要重测。
LLM_VISION_DISABLE_THINKING=0
# 化验单图片上传上限（MB）
LAB_IMAGE_MAX_MB=5

# ========== 2) Embedding 配置 ==========
EMBEDDING_TYPE={{local/api}}  # 待用户手动填充
EMBEDDING_MODEL_PATH={{本地Embedding模型路径}}  # 待用户手动填充（本地）
EMBEDDING_API_BASE={{Embedding API地址}}  # 待用户手动填充（API）
EMBEDDING_API_KEY={{Embedding API密钥}}  # 待用户手动填充（API）
EMBEDDING_MODEL_NAME={{Embedding模型名称}}  # 待用户手动填充

# ========== 3) 数据库配置 ==========
DB_TYPE={{sqlite/mysql}}  # 待用户手动填充
SQLITE_DB_PATH={{本地SQLite文件路径}}  # 待用户手动填充
MYSQL_HOST={{MySQL地址}}  # 待用户手动填充
MYSQL_PORT={{MySQL端口}}  # 待用户手动填充
MYSQL_USER={{MySQL用户名}}  # 待用户手动填充
MYSQL_PASSWORD={{MySQL密码}}  # 待用户手动填充
MYSQL_DATABASE={{MySQL数据库名}}  # 待用户手动填充

# ========== 4) 向量库配置 ==========
VECTOR_STORE_TYPE={{chroma_file/chroma_server/qdrant}}  # 待用户手动填充
CHROMA_PERSIST_DIRECTORY={{本地Chroma存储路径}}  # 待用户手动填充
CHROMA_SERVER_HOST={{Chroma服务地址}}  # 待用户手动填充
CHROMA_SERVER_PORT={{Chroma服务端口}}  # 待用户手动填充
QDRANT_HOST={{Qdrant地址}}  # 待用户手动填充
QDRANT_PORT={{Qdrant端口}}  # 待用户手动填充
QDRANT_API_KEY={{Qdrant API密钥}}  # 待用户手动填充

# ========== 5) Redis 配置（生产） ==========
REDIS_HOST={{Redis地址}}  # 待用户手动填充
REDIS_PORT={{Redis端口}}  # 待用户手动填充
REDIS_PASSWORD={{Redis密码}}  # 待用户手动填充
REDIS_DB=0

# ========== 6) 安全配置 ==========
SECRET_KEY={{JWT加密密钥}}  # 待用户手动填充
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_HOSTS={{允许的跨域域名列表}}  # 待用户手动填充

# ========== 7) 合规配置 ==========
FORCE_DISCLAIMER=true
ENABLE_INPUT_CHECK=true
ENABLE_OUTPUT_CHECK=true

# ========== 8) 服务配置 ==========
APP_ENV=local
LOG_LEVEL=INFO

# ========== 9) 观测配置 ==========
# Langfuse: 生产/开发均可用，未配置则自动禁用
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# LangSmith: 仅开发调试使用，生产建议关闭
LANGSMITH_TRACING=false
